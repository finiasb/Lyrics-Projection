
    <Window x:Class="Proiectie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="d" 
        Title="Proiectie" 
        WindowState="Maximized" 
        Height="600" 
        Width="800" 
        d:DesignHeight="1080" 
        d:DesignWidth="1920" 
        Background="#2D2D2D"
        KeyDown="Window_KeyDown"
        Icon="app_icon.png">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
        
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2D2D2D" BorderBrush="#3F3F3F" BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Label Content="BIBLIOTECĂ CÂNTĂRI" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+" Width="30" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" Cursor="Hand" Click="AddSong_Click"/>
                        <Button Content="⚙" Width="30" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" Cursor="Hand" Click="OpenSettings_Click"/>

                    </StackPanel>
                    <!-- BUTOANE TIP CĂUTARE -->
                    <UniformGrid Columns="2" Margin="5,0,5,10">
                        <RadioButton x:Name="rbTitlu" Content="Titlu" IsChecked="True" Foreground="White" GroupName="SearchType" Checked="SearchType_Changed"/>
                        <RadioButton x:Name="rbContinut" Content="Conținut" Foreground="White" GroupName="SearchType" Checked="SearchType_Changed"/>
                    </UniformGrid>

                    <TextBox x:Name="txtSearch" Height="30" Background="#3F3F3F" Foreground="White" 
                             BorderThickness="0" VerticalContentAlignment="Center" Margin="5,0" PreviewKeyDown="TxtSearch_KeyDown" TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>

                <ListBox x:Name="lstCantari" Grid.Row="1" Margin="0,10,0,50" Background="Transparent" BorderThickness="0" 
                         Foreground="White" DisplayMemberPath="Title" SelectionChanged="lstCantari_SelectionChanged" PreviewKeyDown="lstCantari_KeyDown">
                    <!-- ContextMenu pentru a adăuga la favorite -->
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Adaugă în Program" Click="MenuItem_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <Button Grid.Row="1" 
                    Content="Adaugă în lista" 
                    VerticalAlignment="Bottom" 
                    Height="35" 
                    Margin="5"
                    Background="#007ACC" 
                    Foreground="White" 
                    FontWeight="Bold"
                    Click="MenuItem_Click"/>
                </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20" Background="#2D2D2D">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="lblSelectedTitle" Text="Nicio cântare selectată" 
                       Foreground="#007ACC" FontSize="24" FontWeight="Light" Margin="0,0,0,20"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <!-- Schimbăm din ItemsControl în ListBox -->
                <ListBox x:Name="lstStrofe" Background="Transparent" BorderThickness="0" 
             HorizontalContentAlignment="Stretch"
             KeyDown="lstStrofe_KeyDown" PreviewMouseDown="lstStrofe_PreviewMouseDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border" 
                                    Background="#333" 
                                    BorderBrush="#444" 
                                    BorderThickness="1" 
                                    CornerRadius="5" 
                                    Padding="15">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- Culoarea care RĂMÂNE când strofa e selectată -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                            </Trigger>
                                            <!-- Efect de hover când treci cu mouse-ul -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#888"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="White" 
                           FontSize="18" LineHeight="25"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Background="#2D2D2D" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SECȚIUNEA LIVE -->
                <StackPanel Grid.Row="0">
                    <Label Content="LIVE PE ECRAN" Foreground="#FF4500" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Border Height="150" CornerRadius="5" BorderBrush="#555" BorderThickness="1" ClipToBounds="True">
                        <Grid Background="Black">
                            <Image x:Name="imgPreviewBackground" Stretch="UniformToFill" />
                            <Border Background="Black" Opacity="0.3" />
                            <TextBlock x:Name="txtLiveTextPreview" Text="-" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="10" FontWeight="Bold"/>
                            <TextBlock x:Name="txtLiveClockPreview" Text="" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Top" Margin="5" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Button x:Name="btnToggleProjection" Content="DESCHIDE PROIECȚIA" Margin="0,10,0,5" Height="35" Background="#28A745" Foreground="White" Click="btnToggleProjection_Click"/>
                    <Button Content="ASCUNDE TEXTUL" Height="35" Background="#C0392B" Foreground="White" Click="Blackout_Click" Margin="0,0,0,20"/>
                </StackPanel>

                <!-- SECȚIUNEA FAVORITE (PROGRAM) -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="2" Margin="5,0,5,10">
                        <RadioButton x:Name="rbFavorite" Content="Favorite" IsChecked="True" Foreground="White" GroupName="ListType" Checked="ListType_Changed"/>
                        <RadioButton x:Name="rbIstoric" Content="Istoric" Foreground="White" GroupName="ListType" Checked="ListType_Changed"/>
                    </UniformGrid>
                    
                    <ListBox x:Name="lstFavOrIstoric" Grid.Row="1" Background="#252525" BorderBrush="#333" Foreground="White" 
                             DisplayMemberPath="Title" SelectionChanged="lstFavorite_SelectionChanged"/>
                    <Button Grid.Row="2" x:Name="BtnDeleteFromList" Content="Șterge din favorite" Click="BtnStergeLista_Click" Background="#444" Foreground="White" Margin="0,5,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
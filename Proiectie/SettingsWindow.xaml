<Window x:Class="Proiectie.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setări" Height="550" Width="550" Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="CONFIGURARE" Foreground="#007ACC" FontSize="20" Margin="5,0,0,20"/>

        <ItemsControl x:Name="MonitorsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding DeviceName}" 
                          IsChecked="{Binding IsSelected}" 
                          Foreground="White"
                          Margin="5" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Label Content="Imagine Fundal Proiecție:" Foreground="White"/>
        <Grid Margin="5,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtImagePath" IsReadOnly="True" Background="#333" Foreground="White" VerticalContentAlignment="Center" Padding="5"/>
            <Button Grid.Column="1" Content="Cauta..." Click="SelectImage_Click" Width="80" Margin="5,0,0,0" Background="#007ACC" Foreground="White"/>
        </Grid>

        <Button Content="SALVEAZĂ" Click="Save_Click" Height="35" Background="#28A745" Foreground="White" Margin="5,20,0,0"/>
    </StackPanel>
</Window>   
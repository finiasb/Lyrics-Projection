<Window x:Class="Proiectie.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setări" Height="550" Width="550" Background="#2D2D2D" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="CONFIGURARE" Foreground="#007ACC" FontSize="20" Margin="5,0,0,20"/>

        <ItemsControl x:Name="MonitorsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding DeviceName}" 
                              IsChecked="{Binding IsSelected}" 
                              Foreground="White"
                              Margin="5" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Label Content="Imagine Fundal Proiecție:" Foreground="White"/>
        <Grid Margin="5,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtImagePath" IsReadOnly="True" Background="#333" Foreground="White" VerticalContentAlignment="Center" Padding="8,5" BorderBrush="#555"/>
            <Button Grid.Column="1" Content="Caută..." Click="SelectImage_Click" Width="80" Height="30" Margin="10,0,0,0" Background="#007ACC" Foreground="White" Cursor="Hand"/>
            <Button Grid.Column="2" Content="Șterge" Click="ClearImage_Click" Width="80" Height="30" Margin="10,0,0,0" Background="#C0392B" Foreground="White" Cursor="Hand"/>
        </Grid>

        <CheckBox x:Name="chkShowTracker" Content="Afișează ordinea strofelor pe ecran" Foreground="White" FontSize="14" Margin="5,15,0,5" VerticalContentAlignment="Center"/>
        <Separator Background="#333" Margin="0,15"/>

        <Grid Margin="5,0,5,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Label Content="Font:" Foreground="Gray" Padding="0,0,0,5"/>
                <ComboBox x:Name="cmbFonts" Height="30" DisplayMemberPath="Source"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,5,0">
                <Label Content="Mărime Text:" Foreground="Gray" Padding="0,0,0,5"/>
                <TextBox x:Name="txtFontSize" 
                         Height="30" 
                         Text="36" 
                         Background="#333" 
                         Foreground="White" 
                         VerticalContentAlignment="Center" 
                         HorizontalContentAlignment="Center"
                         Padding="5,0" 
                         BorderBrush="#555"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                <Label Content="Mărime Ceas:" Foreground="Gray" Padding="0,0,0,5"/>
                <TextBox x:Name="txtClockFontSize" 
                         Height="30" 
                         Text="36" 
                         Background="#333" 
                         Foreground="White" 
                         VerticalContentAlignment="Center" 
                         HorizontalContentAlignment="Center"
                         Padding="5,0" 
                         BorderBrush="#555"/>
            </StackPanel>
        </Grid>

        <Button Content="SALVEAZĂ" Click="Save_Click" Height="35" Background="#28A745" Foreground="White" Margin="5,20,0,0" Cursor="Hand"/>
    </StackPanel>
</Window>
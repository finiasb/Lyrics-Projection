<Window x:Class="Proiectie.EditSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="803" Width="595"
        Background="#2D2D2D" Foreground="White" WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="EDITARE CÂNTARE" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Label Content="TITLU CÂNTARE" Foreground="Gray" FontSize="10" FontWeight="Bold" Padding="0,0,0,5"/>
                <Grid>
                    <TextBox x:Name="txtNewTitle" Height="35" Background="#3F3F3F" Foreground="White" BorderThickness="1" BorderBrush="#555" VerticalContentAlignment="Center" Padding="10,0"/>
                    <TextBlock IsHitTestVisible="False" Foreground="#777" VerticalAlignment="Center" Margin="12,0" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtNewTitle}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Label Content="AUTOR" Foreground="Gray" FontSize="10" FontWeight="Bold" Padding="0,0,0,5"/>
                <Grid>
                    <TextBox x:Name="txtNewAuthor" Height="35" Background="#3F3F3F" Foreground="White" BorderThickness="1" BorderBrush="#555" VerticalContentAlignment="Center" Padding="10,0"/>
                    <TextBlock IsHitTestVisible="False" Foreground="#777" VerticalAlignment="Center" Margin="12,0" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtNewAuthor}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Content="Conținut (separă strofele cu un rând liber, fiecare strofă să fie numerotată și refrenul să înceapă cu 'R:')" Foreground="Gray"/>
            <Grid Grid.Row="1">
                <TextBox x:Name="txtNewContent" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#3F3F3F" Foreground="White" BorderThickness="1" BorderBrush="#555" Padding="10" TextWrapping="Wrap" FontFamily="Consolas"/>
                <TextBlock IsHitTestVisible="False" Foreground="#777" VerticalAlignment="Top" Margin="12,12,0,0" FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtNewContent}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Salvează Local" Margin="0,0,35,0" Width="200" Height="35"  Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveLocal_Click"/>
            <Button Content="Salvează Global" Margin="35,0,0,0" Width="200" Height="35" Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveGlobal_Click"/>
        </StackPanel>
    </Grid>
</Window>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icons\add.ico" />
    <None Remove="Icons\app_icon.png" />
    <None Remove="Icons\edit.png" />
    <None Remove="Icons\edit2.png" />
    <None Remove="Icons\settings.ico" />
    <None Remove="Icons\settings2.png" />
    <None Remove="Icons\trash.ico" />
    <None Remove="Icons\trash2.ico" />
    <None Remove="Icons\trash2.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.7" />
    <PackageReference Include="SQLite" Version="3.13.0" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Icons\add.ico" />
    <Resource Include="Icons\app_icon.png" />
    <Resource Include="Icons\edit.png" />
    <Resource Include="Icons\edit2.png" />
    <Resource Include="Icons\settings.ico" />
    <Resource Include="Icons\settings2.png" />
    <Resource Include="Icons\trash.ico" />
    <Resource Include="Icons\trash2.ico" />
    <Resource Include="Icons\trash2.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
